# WARNING:
# Use real credentials only in your local `.env`.
# Never commit secrets, tokens, refresh tokens, or exported account JSON.

# Telegram
# Required for webhook delivery and Telegram replies.
TELEGRAM_BOT_TOKEN=
WEBHOOK_SECRET=

# AI Providers
# At least one provider is needed for LLM-backed routing, summaries, and chat.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
LLM_TIMEOUT_SECONDS=15

# Google OAuth
# GOOGLE_REFRESH_TOKEN is used for bootstrap health validation.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.modify,https://www.googleapis.com/auth/calendar,https://www.googleapis.com/auth/drive

# Stored Google Accounts
# Optional. In cloud deployments this can replace a local `accounts.json`.
# Expected format: {"user@example.com":{"refresh_token":"...","client_id":"...","client_secret":"..."}}
ACCOUNTS_JSON=

# GitHub Integration
# Optional. Required only for Phase 6 GitHub features.
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com
GITHUB_USER_AGENT=personal-ai-assistant

# Local Persistence
# Optional. Defaults are usually fine for local development.
MEMORY_DB_PATH=memory/assistant_memory.db

# Logging
LOG_LEVEL=INFO
