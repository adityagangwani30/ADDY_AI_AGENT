# WARNING: Use real credentials only in local .env. Never commit secrets.

# Gemini
GEMINI_API_KEY=replace_with_real_key
GEMINI_MODEL_PRIMARY=gemini-2.5-flash
GEMINI_MODEL_FALLBACKS=gemini-2.0-flash

# Google OAuth client
GOOGLE_CLIENT_ID=replace_with_client_id
GOOGLE_CLIENT_SECRET=replace_with_client_secret
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.modify,https://www.googleapis.com/auth/calendar,https://www.googleapis.com/auth/drive

# Telegram
TELEGRAM_BOT_TOKEN=replace_with_bot_token

# Accounts (JSON string containing refresh tokens per account)
ACCOUNTS_JSON={"email@gmail.com": {"refresh_token": "..."}}

# Memory DB (only needed for local dev; defaults work out of the box)
MEMORY_DB_PATH=memory/assistant_memory.db

# API Security
WEBHOOK_SECRET=replace_with_shared_secret
LOG_LEVEL=INFO
